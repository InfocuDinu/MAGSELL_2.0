# SmartBill API v2 credentials/config
SMARTBILL_API_BASE_URL=https://ws.smartbill.ro/SBORO/api
SMARTBILL_API_STOCK_DOCUMENT_PATH=/stock/v2/documents
SMARTBILL_EMAIL=your-smartbill-email@example.com
SMARTBILL_TOKEN=your-smartbill-token
SMARTBILL_COMPANY_VAT_CODE=RO12345678
SMARTBILL_RETRY_MAX_ATTEMPTS=3
SMARTBILL_RETRY_INITIAL_DELAY_MS=1000
SMARTBILL_TIMEOUT_MS=10000

# Security hardening
APP_SECURITY_REQUIRE_ENV_SECRETS=false
APP_SECURITY_MASTER_KEY=replace-with-strong-32+-char-secret
APP_SECURITY_MASTER_KEY_ID=key-v1
APP_SECURITY_MASTER_KEY_ROTATED_AT=2026-03-05
APP_SECURITY_MAX_KEY_AGE_DAYS=90

# Performance monitoring (optional)
APP_PERFORMANCE_MONITOR_ENABLED=true
APP_PERFORMANCE_SLOW_THRESHOLD_MS=250
APP_PERFORMANCE_REPORT_INTERVAL_MS=300000
